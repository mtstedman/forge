# Database settings for the Forge API. Append these lines to the repository-root
# .env (the API, api/bin/migrate.php and the tests all read that single file).
#
# DATABASE_URL is preferred. Relative SQLite paths resolve against the
# repository root; the directory is created on first connect.
#   sqlite:api/var/forge.sqlite        relative to the repository root
#   sqlite:///absolute/path/forge.sqlite
# The bundled schema (api/database/schema.sql) is written for SQLite.
DATABASE_URL="sqlite:api/var/forge.sqlite"

# Fallback used only when DATABASE_URL is empty or unset.
DB_CONNECTION="sqlite"
DB_DATABASE="api/var/forge.sqlite"
