# Application settings for the Forge API and website. Copy this file to the
# repository-root .env, then append database.env.example for the database
# connection. Every entry point (API, migration script, website) loads that
# one .env file; values already present in the process environment win.

# --- API (api/src) -----------------------------------------------------------
# `dev` includes error details in API responses; anything else hides them.
APP_ENV=production
# Secret HMAC key used to hash commenter IP addresses. Public comments stay
# closed while this is empty. Generate one:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://ancoratiming.com
# Public comment submission is off by default; comments also need approval.
PUBLIC_COMMENTS_ENABLED=false
COMMENT_RATE_LIMIT=3
# Admin API protection (OAuth 2.0 / OIDC access tokens). All three are required
# before any /admin route answers.
OAUTH_ISSUER=
OAUTH_AUDIENCE=https://api.ancoratiming.com
OAUTH_JWKS_URL=
OAUTH_REQUIRED_SCOPE=
# Media uploads. Relative paths resolve against the repository root.
UPLOAD_DIR=api/public/uploads
UPLOAD_MAX_BYTES=5242880
MEDIA_BASE_URL=/uploads

# --- Website (src) -----------------------------------------------------------
# Site origin used for canonical URLs, the sitemap and robots.txt.
SITE_URL=https://ancoratiming.com
# API base URL for the PHP pages (server side) and for browser scripts.
API_BASE_URL=https://api.ancoratiming.com
PUBLIC_API_URL=https://api.ancoratiming.com
# Admin sign-in (public PKCE client). OAUTH_AUDIENCE must match the API's.
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_SCOPE=openid profile email
OAUTH_REDIRECT_URI=https://ancoratiming.com/admin/
